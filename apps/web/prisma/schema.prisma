generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InventoryLocation {
  PANTRY
  FRIDGE
  FREEZER
}

enum HealthMetricType {
  HYDRATION_ML
  STEPS
  ACTIVE_CALORIES
  TOTAL_CALORIES
  EXERCISE_MINUTES
  DISTANCE_METRES
  SLEEP_MINUTES
  WEIGHT_KG
}

enum ReceiptStatus {
  DRAFT
  IMPORTED
  CANCELLED
}

enum ProductType {
  GENERIC_PRODUCE
  PACKAGED
  FRESH_MEAT
  SEAFOOD
  DAIRY
  BAKERY
  FROZEN
  HOUSEHOLD
  PERSONAL_CARE
  BEVERAGE
  OTHER
}

enum ProductLifecycle {
  NEW
  MATCHED
  ENRICHING
  READY
  REVIEW_REQUIRED
  ARCHIVED
}

enum EnrichmentJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  RETRY_SCHEDULED
}

model Product {
  id                  String               @id @default(cuid())
  name                String
  canonicalName       String?
  slug                String?              @unique
  brand               String?
  barcode             String?              @unique
  category            String?
  description         String?
  imageUrl             String?
  packSize             String?
  packQuantity         Float?
  packUnit             String?
  servingSize          String?
  servingQuantity      Float?
  servingUnit          String?
  servingsPerPackage   Float?
  calories             Float?
  proteinGrams         Float?
  carbsGrams           Float?
  fatGrams             Float?
  saturatedFatGrams    Float?
  fibreGrams           Float?
  sugarGrams           Float?
  sodiumMg             Float?
  allergens            String[]             @default([])
  dietaryTags          String[]             @default([])
  foodKnowledgeId      String?
  productType          ProductType          @default(PACKAGED)
  lifecycle            ProductLifecycle     @default(NEW)
  confidenceScore      Float                @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  foodKnowledge        FoodKnowledge?       @relation(fields: [foodKnowledgeId], references: [id], onDelete: SetNull)
  aliases              ProductAlias[]
  inventoryItems       InventoryItem[]
  ingredientRecords    Ingredient[]
  shoppingItems        ShoppingItem[]
  receiptItems         ReceiptItem[]
  supermarketPrices    SupermarketPrice[]
  storeProducts        StoreProduct[]
  priceObservations    PriceObservation[]
  enrichmentJobs       ProductEnrichmentJob[]

  @@index([foodKnowledgeId])
  @@index([productType, lifecycle])
}

model FoodKnowledge {
  id             String    @id @default(cuid())
  commonName     String    @unique
  scientificName String?
  foodGroup      String?
  category       String?
  subCategory    String?
  description    String?
  storageGuide   String?
  seasonality    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]
}

model ProductEnrichmentJob {
  id          String              @id @default(cuid())
  productId   String
  provider    String
  status      EnrichmentJobStatus @default(QUEUED)
  priority    Int                 @default(100)
  attempts    Int                 @default(0)
  lastError   String?
  nextRetryAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, priority, createdAt])
  @@index([productId, status])
  @@index([nextRetryAt])
}

model ProductAlias {
  id         String   @id @default(cuid())
  productId  String
  alias      String
  normalised String   @unique
  source     String?
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model StoreProduct {
  id                  String             @id @default(cuid())
  productId           String
  retailer            String
  externalId          String?
  retailerProductName String
  brand               String?
  packSize            String?
  packQuantity        Float?
  packUnit            String?
  productUrl          String?
  imageUrl             String?
  aisle               String?
  active              Boolean            @default(true)
  lastSeenAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceObservations   PriceObservation[]

  @@unique([retailer, externalId])
  @@index([productId, retailer])
  @@index([retailer, retailerProductName])
}

model PriceObservation {
  id             String        @id @default(cuid())
  productId      String
  storeProductId String?
  retailer       String
  price          Float
  unitPrice      Float?
  unitLabel      String?
  isSpecial      Boolean       @default(false)
  source         String
  sourceUrl      String?
  observedAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeProduct   StoreProduct? @relation(fields: [storeProductId], references: [id], onDelete: SetNull)

  @@index([productId, observedAt])
  @@index([retailer, observedAt])
  @@index([storeProductId, observedAt])
}

model InventoryItem {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  location    InventoryLocation
  quantity    Float
  unit        String
  expiresAt   DateTime?
  purchasedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([productId])
  @@index([location])
  @@index([expiresAt])
}

model Recipe {
  id           String             @id @default(cuid())
  name         String
  description  String?
  instructions String?
  servings     Int                @default(1)
  prepMinutes  Int?
  cookMinutes  Int?
  calories     Float?
  proteinGrams Float?
  carbsGrams   Float?
  fatGrams     Float?
  fibreGrams   Float?
  sourceKey    String?            @unique
  sourceName   String?
  sourceUrl    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  ingredients  RecipeIngredient[]
}

model Ingredient {
  id        String             @id @default(cuid())
  name      String             @unique
  productId String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  product   Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  recipes   RecipeIngredient[]

  @@index([productId])
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float
  unit         String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
}

model ShoppingList {
  id        String         @id @default(cuid())
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     ShoppingItem[]
}

model ShoppingItem {
  id             String       @id @default(cuid())
  shoppingListId String
  productId      String?
  name           String
  quantity       Float?
  unit           String?
  checked        Boolean      @default(false)
  stockedAt      DateTime?
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([shoppingListId])
  @@index([productId])
}

model HealthMetric {
  id         String           @id @default(cuid())
  type       HealthMetricType
  value      Float
  recordedAt DateTime
  source     String?
  createdAt  DateTime         @default(now())

  @@index([type, recordedAt])
}

model ReceiptImport {
  id          String        @id @default(cuid())
  retailer    String?
  purchasedAt DateTime?
  total       Float?
  imagePath   String?
  fingerprint String?       @unique
  status      ReceiptStatus @default(DRAFT)
  importedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       ReceiptItem[]

  @@index([status, createdAt])
}

model ReceiptItem {
  id              String             @id @default(cuid())
  receiptImportId String
  productId       String?
  rawDescription  String
  normalisedName  String?
  quantity        Float?
  unit            String?
  price           Float?
  isFood          Boolean?
  location        InventoryLocation?
  expiresAt       DateTime?
  receiptImport   ReceiptImport      @relation(fields: [receiptImportId], references: [id], onDelete: Cascade)
  product         Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([receiptImportId])
  @@index([productId])
}

model SupermarketPrice {
  id          String   @id @default(cuid())
  productId   String?
  retailer    String
  productName String
  brand       String?
  packSize    String?
  price       Float
  unitPrice   Float?
  isSpecial   Boolean  @default(false)
  checkedAt   DateTime @default(now())
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([retailer, productName])
  @@index([productId, checkedAt])
}

model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  sessions          Session[]
  accounts          Account[]
  members           Member[]
  invitations       Invitation[]
  recipeFavourites  RecipeFavourite[]
  weeklyMealPlans   WeeklyMealPlan[]
  preference        UserPreference?

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress             String?
  userAgent             String?
  userId                String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String       @unique
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model RecipeFavourite {
  id               String   @id @default(cuid())
  userId           String
  externalRecipeId String
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalRecipeId])
  @@index([externalRecipeId])
}

model UserPreference {
  userId             String   @id
  homeLocation       String?
  homePostcode       String?
  lockToHomeLocation Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeeklyMealPlan {
  id        String                @id @default(cuid())
  userId    String
  weekStart DateTime
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   WeeklyMealPlanEntry[]

  @@unique([userId, weekStart])
  @@index([weekStart])
}

model WeeklyMealPlanEntry {
  id         String         @id @default(cuid())
  mealPlanId String
  day        Int
  recipeKey  String
  servings   Int
  mealPlan   WeeklyMealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@unique([mealPlanId, day])
  @@index([recipeKey])
}
