{
  "name": "food-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3100",
    "prebuild": "rm -rf .next && prisma generate",
    "build": "next build --webpack && node scripts/verify-production-bundle.mjs && node scripts/copy-standalone-assets.mjs",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "worker:enqueue-images": "tsx scripts/enqueue-selected-product-images.ts",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "grocery:intelligence:test": "tsx scripts/test-grocery-intelligence.ts",
    "products:names:test": "tsx scripts/test-product-name-quality.ts",
    "products:nip:test": "tsx scripts/test-australian-nip-parser.ts",
    "products:audit": "tsx scripts/audit-product-catalogue.ts",
    "products:audit:export": "prisma generate && tsx scripts/export-product-catalogue-audit.ts",
    "products:backfill": "tsx scripts/backfill-product-intelligence.ts",
    "products:backfill:apply": "tsx scripts/backfill-product-intelligence.ts --apply",
    "products:reconcile": "tsx scripts/reconcile-product-catalogue.ts",
    "products:reconcile:apply": "tsx scripts/reconcile-product-catalogue.ts --apply",
    "products:cleanup": "tsx scripts/cleanup-product-intelligence.ts",
    "products:cleanup:apply": "tsx scripts/cleanup-product-intelligence.ts --apply",
    "products:images": "tsx scripts/enrich-product-images.ts",
    "products:images:import": "tsx scripts/import-selected-product-images.ts",
    "products:images:audit": "tsx scripts/audit-product-images.ts",
    "products:images:audit:apply": "tsx scripts/audit-product-images.ts --apply",
    "grocery:canonical:backfill": "tsx scripts/backfill-canonical-grocery-intelligence.ts",
    "grocery:canonical:backfill:apply": "tsx scripts/backfill-canonical-grocery-intelligence.ts --apply",
    "apke:backfill": "tsx scripts/backfill-apke.ts",
    "apke:backfill:apply": "tsx scripts/backfill-apke.ts --apply",
    "prices:import:auscost": "tsx scripts/import-auscost-prices.ts",
    "recipes:sync:bhf": "node scripts/sync-bhf-recipes.mjs"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.25",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.8.0",
    "@zxing/browser": "^0.2.1",
    "better-auth": "^1.6.25",
    "dotenv": "^17.4.2",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^20",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
